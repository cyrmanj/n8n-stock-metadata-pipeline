    {
      "parameters": {
        "jsCode": "// Capture the first item from the input stream\nconst inputItem = $input.item;\nconst rawText = inputItem.json.content.parts[0].text;\n\n// Variables to store extracted metadata\nlet title = '';\nlet description = '';\nlet keywords = '';\n\n// Normalize text: remove carriage returns and trim spaces\nconst cleanText = rawText.replace(/\\r/g, '').trim();\n\n// 1. EXTRACT TITLE: Search between \"Title:\" and \"Description:\"\nconst titleStart = cleanText.search(/Title:/i);\nconst descStart = cleanText.search(/Description:/i);\nconst keyStart = cleanText.search(/Keywords:/i);\n\nif (titleStart !== -1 && descStart !== -1) {\n  title = cleanText.substring(titleStart + 6, descStart).trim();\n}\n\n// 2. EXTRACT DESCRIPTION: Search between \"Description:\" and \"Keywords:\"\nif (descStart !== -1 && keyStart !== -1) {\n  description = cleanText.substring(descStart + 12, keyStart).trim();\n}\n\n// 3. EXTRACT KEYWORDS: Search from \"Keywords:\" to the end\nif (keyStart !== -1) {\n  let rawKeywords = cleanText.substring(keyStart + 9).trim();\n  // Handle edge cases where Gemini appends the category at the very end\n  keywords = rawKeywords.split(/category:/i)[0].trim();\n}\n\n// Final sanitization: replace structural line breaks with spaces\ntitle = title.replace(/\\n+/g, ' ');\ndescription = description.replace(/\\n+/g, ' ');\nkeywords = keywords.replace(/\\n+/g, ' ');\n\n// Return clean, structured data keys\nreturn {\n  extractedTitle: title,\n  extractedDescription: description,\n  extractedKeywords: keywords\n};"
      },
